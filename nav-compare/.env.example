# 이 파일을 .env 로 복사한 뒤 키를 채우세요. (.env 는 git에 올라가지 않습니다)
# 키가 하나도 없으면 데모(가상) 데이터로, 일부만 있으면 키 없는 곳은 비교에서 빠집니다.

# TMAP  — https://openapi.sk.com  (TMAP API 상품 → 앱 키)
TMAP_APP_KEY=

# 네이버 클라우드 플랫폼 — 새 Maps 상품에서 Application 등록 (Directions 5 체크)
# 옛 "AI NAVER API" 지도 API는 2026-11-24에 종료되어 그 키는 쓸 수 없습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 — https://developers.kakao.com  (REST API 키, 카카오맵/카카오모빌리티 길찾기 사용 설정)
KAKAO_REST_API_KEY=

PORT=3000
