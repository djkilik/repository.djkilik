# 이 파일을 .env 로 복사한 뒤 키를 채우세요. (.env 는 git에 올라가지 않습니다)
# 키가 비어 있는 서비스는 데모(가상) 데이터로 표시됩니다.

# TMAP  — https://openapi.sk.com  (TMAP API 상품 → 앱 키)
TMAP_APP_KEY=

# 네이버 클라우드 플랫폼 — Maps 서비스에서 Application 등록 (Directions 5 체크)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구(舊) AI·NAVER API 상품을 쓰는 경우 아래 주석 해제
# NAVER_DIRECTIONS_URL=https://naveropenapi.apigw.ntruss.com/map-direction/v1/driving

# 카카오 — https://developers.kakao.com  (REST API 키, 카카오맵/카카오모빌리티 길찾기 사용 설정)
KAKAO_REST_API_KEY=

PORT=3000
